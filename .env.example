# --- Supabase (public values, safe for client bundles) ---
# Local values: run `pnpm supabase:status`. Mobile reads apps/mobile/.env instead of this file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only. NEVER expose these to a client bundle or commit real values ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Bearer token required by /api/cron/fx (exchange rates). Generate a long random value.
CRON_SECRET=

# Optional: show "Continuar con Google" (enable [auth.external.google] in supabase/config.toml first)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
